# ===============================
# Application
# ===============================

NODE_ENV=production

PORT=5001

FRONTEND_URL=https://your-frontend-domain.com
BACKEND_URL=https://your-backend-domain.com/api
APP_URL=https://your-backend-domain.com


# ===============================
# Database (MySQL Production)
# ===============================

DB_HOST=your-database-host.example.com
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=your_database_password_here
DB_CA=your_ca_certificate_path_or_content


# ===============================
# Authentication
# ===============================

ACCESS_TOKEN_SECRET=your_strong_access_token_secret
ACCESS_TOKEN_EXPIRE=15m


REFRESH_TOKEN_SECRET=your_strong_refresh_token_secret
REFRESH_TOKEN_EXPIRE=7d


VERIFY_TOKEN_SECRET=your_strong_verify_token_secret
VERIFY_TOKEN_EXPIRE=15m


# ===============================
# Email Configuration
# ===============================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_email@gmail.com
SMTP_PASS=your_gmail_app_password_here

EMAIL_SECRET=your_email_secret_here


# ===============================
# Resend Email Service
# ===============================

RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=your-email@example.com


# ===============================
# Payment Gateway (bKash)
# ===============================

BKASH_BASE_URL=https://tokenized.sandbox.bka.sh

BKASH_USERNAME=your_bkash_username
BKASH_PASSWORD=your_bkash_password
BKASH_APP_KEY=your_bkash_app_key
BKASH_APP_SECRET=your_bkash_app_secret


# ===============================
# Cloudinary Configuration
# ===============================

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret


# ===============================
# Application Timezone
# ===============================

APP_TIMEZONE=Asia/Dhaka
